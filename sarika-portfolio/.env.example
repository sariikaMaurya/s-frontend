# Local MongoDB default. Replace with your Atlas connection URI to use MongoDB Atlas.
#MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=portfolio

# Atlas URI format:
MONGODB_URI=
# Optional, comma-separated DNS servers for environments where the system DNS
# resolver cannot resolve MongoDB Atlas SRV records.
#MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1